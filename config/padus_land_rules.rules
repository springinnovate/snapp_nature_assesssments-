public_land =
    Mang_Type in {FED, STAT, LOC, DIST, JNT, TERR}
    OR (
        Mang_Type in {UNK}
        AND Des_Tp in {
            ACC, AGRE, FOTH, FORE, LCA, LHCA, LOTH, LP, LREC, LRMA,
            MIL, RECE, REA, SCA, SHCA, SOTH, SP, SREC, SRMA, WPA
        }
    )

public_access =
    public_land
    AND manager not in {NASA}
    AND (
        Pub_Access in {OA}
        OR (
            Pub_Access in {RA, UK}
            AND Own_Type not in {PVT}
            AND manager not in {DOD, DOE}
            AND Des_Tp not in {
                MIL,
                PAGR,
                PCON,
                PFOR,
                PHCA,
                POTH,
                PPRK,
                PRAN,
                PREC
            }
        )
    )
