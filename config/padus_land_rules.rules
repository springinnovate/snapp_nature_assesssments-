public_land =
    Own_Type not in {TRIB}
    AND (
            (
                Own_Type in {DIST, FED, JNT, LOC, STAT}
            ) OR (
                (
                    Own_Type in {DESG, NGO, PVT, UNK}
                ) AND (
                    Mang_Type in {DIST, FED, JNT, LOC, STAT}
                )
            )
    )

public_access =
    public_land
    AND (
        Pub_Access in {OA}
        OR (
            Pub_Access in {RA, UK}
            AND Own_Type not in {PVT}
            AND manager not in {DOD, DOE, NASA}
            AND Des_Tp not in {
                MIL,
                PAGR,
                PCON,
                PFOR,
                PHCA,
                POTH,
                PPRK,
                PRAN,
                PREC
            }
        )
    )
