# PAD-US values use the stored geodatabase codes, not their display labels.
# `manager` is a normalized value derived from Mang_Name and Loc_Mang so the
# PAD-US 4.1 representation of NASA can be expressed as a stable rule value.

public_land =
    Own_Type in {FED, JNT, LOC, DIST, STAT, TERR}
    OR (
        Own_Type in {NGO, PVT, UNK}
        AND Mang_Type in {FED, LOC, DIST, STAT}
    )

public_access =
    public_land
    AND Des_Tp not in {MIL, PCON, POTH, PPRK, PREC}
    AND manager not in {NASA, DOE}
